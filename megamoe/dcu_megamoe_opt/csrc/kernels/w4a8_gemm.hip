                                *( vec<Element, 8> *)(&A_reg[m_tile][i].int8t_array[k_tile]), 
                                *( vec<Element, 8> *)(&B_reg[n_tile * 2 + it][stage_b_flag][i].int8t_array[k_tile]), 
                                C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it]);
                } else {
                    C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it] = mmac<Element>(
                                *( vec<Element, 8> *)(&B_reg[n_tile * 2 + it][stage_b_flag][i].int8t_array[k_tile]), 
                                *( vec<Element, 8> *)(&A_reg[m_tile][i].int8t_array[k_tile]), 
                                C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it]);
                }
            }
        }
    }
}

__builtin_amdgcn_sched_barrier(0);

    vmcnt_wait(A_PREFETCH_COUNT);

    if(kloop == k_loop_count - 1 ){
        vmcnt_wait(  0 );
    }
    

i = 1;

__builtin_amdgcn_sched_barrier(0);

    

            
     
    #pragma unroll
    for(int n_tile = 0; n_tile < WARP_N / 32; n_tile++){
        #pragma unroll
        for(int it = 0 ;it < 2 ; it++){
            
            uint32_t packed_val[2];
            #pragma unroll
            for(int k_tile = 0; k_tile < WARP_K / MFMA_K; k_tile++){

                packed_val[k_tile] = *(uint32_t*)(&(weight_reg_tmp[n_tile ][stage_b_flag][i].i[it * 2 +k_tile])) ;

            }  
            #pragma unroll
            for(int k_tile = 0; k_tile < WARP_K / MFMA_K; k_tile++){
                uint32_t packed_val_first = packed_val[k_tile] & 0xf0f0f0f0;
                uint32_t packed_val_second = (packed_val[k_tile] << 4) &  0xf0f0f0f0;
                B_reg[n_tile * 2 + it][stage_b_flag][i].int2_array[k_tile][0] = *(int*)&packed_val_first;
                B_reg[n_tile * 2 + it][stage_b_flag][i].int2_array[k_tile][1] = *(int*)&packed_val_second;
            } 
        }
    }

  

__builtin_amdgcn_sched_barrier(0);

#pragma unroll
for(int m_tile = 0; m_tile < WARP_M / MFMA_M; m_tile++){
    #pragma unroll
    for(int n_tile = 0; n_tile < WARP_N / 32; n_tile++){
        #pragma unroll
        for(int it = 0 ;it < 2 ; it++){
            #pragma unroll
            for(int k_tile = 0; k_tile < WARP_K / MFMA_K; k_tile++){
                if constexpr (ABC_ORDER) {
                    C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it] = mmac<Element>(
                                *( vec<Element, 8> *)(&A_reg[m_tile][i].int8t_array[k_tile]), 
                                *( vec<Element, 8> *)(&B_reg[n_tile * 2 + it][stage_b_flag][i].int8t_array[k_tile]), 
                                C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it]);
                } else {
                    C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it] = mmac<Element>(
                                *( vec<Element, 8> *)(&B_reg[n_tile * 2 + it][stage_b_flag][i].int8t_array[k_tile]), 
                                *( vec<Element, 8> *)(&A_reg[m_tile][i].int8t_array[k_tile]), 
                                C_reg[n_loop][m_tile*(WARP_N/MFMA_N) + n_tile * 2 + it]);
                }
            }
        }
    }
}
__builtin_amdgcn_sched_barrier(0);

__builtin_amdgcn_sched_barrier(0);

    }
else if constexpr (STAGE == 1){
;
}

}
    }

template<
  typename scalar_t,
  typename Element,
  int WARP_NUM,
  int BLOCK_SIZE_M,
  int BLOCK_SIZE_N,
  int BLOCK_SIZE_K,
  int WARP_M,
  int WARP_N,
  int WARP_K,
  int GROUP_N,
  int GROUP_K,
  int STAGES,
  int N_LOOP_NUM = 4,
  bool DIRECT_DWORDX4 = true,
  bool LDS_SWIZZLE = false,
  bool VECTOR_A = false>
__global__ void __launch_bounds__(WARP_NUM * 64,1) W4A8_I8_PERCHANNEL_MARLIN_HIP_NT_CONTIGUOUS(
  const Element* __restrict__ input,
  const Element* __restrict__ qweight,
  scalar_t* __restrict__ output,
  float* __restrict__ input_scale,
  float* __restrict__ weight_scale,
  const int32_t* __restrict__ m_indices,
  uint32_t size_m,
  uint32_t size_n,
  uint32_t size_k,
  uint32_t stride_asm,
  uint32_t stride_bse,
  uint32_t stride_bsn,
  uint32_t stride_bsk,
  uint32_t num_experts
) {
  const int bidx = blockIdx.z;
  const int bidy = blockIdx.y;
  const int block_m_base = bidx * BLOCK_SIZE_M;
  if (block_m_base >= size_m) {
    return;
  }

  const int expert_id = __builtin_amdgcn_readfirstlane(m_indices[block_m_base]);
  if (expert_id < 0 || expert_id >= num_experts) {
    return;
  }
  const bool full_contiguous_block =
      block_m_base + BLOCK_SIZE_M <= size_m &&
      m_indices[block_m_base + BLOCK_SIZE_M - 1] == expert_id;

  constexpr int mfma_m = 16;
  constexpr int mfma_n = 16;
  constexpr int n_loop_num = N_LOOP_NUM;
  int warp_id_vec = threadIdx.x / 64;
  int warp_id = __builtin_amdgcn_readfirstlane(warp_id_vec);
  const int warp_n_id = warp_id % (BLOCK_SIZE_N / WARP_N);
  const int warp_m_id = warp_id / (BLOCK_SIZE_N / WARP_N);
  int lane_id = threadIdx.x & 63;
  int row_id = lane_id % 16;
  int col_id = lane_id / 16;

  extern __shared__ Element smem[];
  Element* input_lds = (Element*)&(smem);
  Element* qweight_lds = input_lds;

  union_vec_opt<Element, WARP_K / 4> A_reg[WARP_M / mfma_m][STAGES];
  union_vec_opt<Element, WARP_K / 4> B_reg[WARP_N / mfma_n][2][STAGES];
  intx4 C_reg[n_loop_num][(WARP_M/16)*(WARP_N/16)] = {0,0,0,0};

  const uint64_t expert_offset = static_cast<uint64_t>(size_n) * size_k / 2 * expert_id;
  const uint64_t qweight_offset = expert_offset + bidy * 32 * BLOCK_SIZE_N * n_loop_num;
  const uint64_t weight_scale_offset = stride_bse * expert_id + bidy * BLOCK_SIZE_N * n_loop_num;
  auto g_qweight = qweight + qweight_offset;
  auto g_weight_scale = weight_scale + weight_scale_offset;

  float b_scale_dwordx4[n_loop_num][8];
  __builtin_amdgcn_sched_barrier(0);
  constexpr int SIZE_K = 0;
  gemm_nt_marlin_prefill_w4a8<
      false, 0, 0, WARP_NUM, BLOCK_SIZE_M, BLOCK_SIZE_N, BLOCK_SIZE_K,
      WARP_M, WARP_N, WARP_K, STAGES, GROUP_N, GROUP_K, SIZE_K, Element,
      scalar_t, N_LOOP_NUM, DIRECT_DWORDX4, LDS_SWIZZLE, VECTOR_A>(
      input, g_qweight, input_lds, qweight_lds, input_scale, g_weight_scale,
      size_m, A_reg, B_reg, C_reg, warp_id, size_k, size_k, stride_asm, 1,
      stride_bse, stride_bsn, stride_bsk, bidx);
  __builtin_amdgcn_sched_barrier(0);

  if constexpr (DIRECT_DWORDX4) {
    #pragma unroll
    for (int n_loop = 0; n_loop < n_loop_num; n_loop++) {
      const int scale_base = weight_scale_offset + BLOCK_SIZE_N * n_loop +
                             warp_n_id * WARP_N + col_id * 8;
      #pragma unroll
      for (int i = 0; i < 8; i++) {
        b_scale_dwordx4[n_loop][i] = weight_scale[scale_base + i];
      }
    }
    vmcnt_wait(0);

    auto store_contiguous_row = [&](int n_loop, int min_tile_m, int row) {
      const float a_scale_value = input_scale[row * stride_asm];
      vec_element_8<scalar_t> packed_store_value;
      const int tile_idx = min_tile_m * (WARP_N / mfma_n);
      #pragma unroll
      for (int reg_id = 0; reg_id < 4; reg_id++) {
        scalar_t store_pair[2];
        #pragma unroll
        for (int pair_id = 0; pair_id < 2; pair_id++) {
          const int acc = C_reg[n_loop][tile_idx + pair_id][reg_id] / 16;
          const float scaled =
              static_cast<float>(acc) * a_scale_value *
              b_scale_dwordx4[n_loop][reg_id * 2 + pair_id];
          store_pair[pair_id] = b32_to_b16<scalar_t>(scaled);
        }
        #pragma unroll
        for (int pair_id = 0; pair_id < 2; pair_id++) {
          packed_store_value.data[reg_id * 2 + pair_id] = store_pair[pair_id];
        }
      }
      const int n_index = bidy * BLOCK_SIZE_N * n_loop_num +
                          BLOCK_SIZE_N * n_loop +
                          warp_n_id * WARP_N + col_id * 8;
      *reinterpret_cast<vec_element_8<scalar_t>*>(
          &output[static_cast<int64_t>(row) * size_n + n_index]) =
          packed_store_value;
    };

    if (full_contiguous_block) {
      #pragma unroll
      for (int n_loop = 0; n_loop < n_loop_num; n_loop++) {
        #pragma unroll
        for (int min_tile_m = 0; min_tile_m < (WARP_M / mfma_m); min_tile_m++) {
          const int row = block_m_base + warp_m_id * WARP_M + min_tile_m * mfma_m + row_id;
          store_contiguous_row(n_loop, min_tile_m, row);
        }
      }
    } else {
      #pragma unroll
      for (int n_loop = 0; n_loop < n_loop_num; n_loop++) {
        #pragma unroll
        for (int min_tile_m = 0; min_tile_m < (WARP_M / mfma_m); min_tile_m++) {
          const int row = block_m_base + warp_m_id * WARP_M + min_tile_m * mfma_m + row_id;
          if (row < size_m && m_indices[row] == expert_id) {
            store_contiguous_row(n_loop, min_tile_m, row);
          }
        }
      }
    }
  }
}

template<int BLOCK_SIZE_M, int BLOCK_SIZE_N, int BLOCK_SIZE_K, int WARP_M, int WARP_N, int WARP_K, int STAGES, typename T, typename T_hidden, int N_LOOP_NUM, bool DIRECT_DWORDX4, bool LDS_SWIZZLE = false, bool VECTOR_A = false>
void launch_w4a8_hipc_contiguous_direct(const GemmParams_w4a8_contiguous<T,T_hidden>& params) {
    constexpr int WARP_NUM = (BLOCK_SIZE_M / WARP_M) * (BLOCK_SIZE_N / WARP_N) * (BLOCK_SIZE_K / WARP_K);
    constexpr int GROUP_N = 1;
    constexpr int GROUP_K = 1;
    dim3 blockDim(WARP_NUM * 64, 1, 1);
    dim3 gridDim(1, DIVIDE(params.size_n, BLOCK_SIZE_N * N_LOOP_NUM),
                 DIVIDE(params.size_m, BLOCK_SIZE_M));
    const int shared_mem_size = BLOCK_SIZE_M * WARP_K * 2;
    const hipStream_t stream = at::cuda::getCurrentHIPStream();

   hipLaunchKernelGGL(( W4A8_I8_PERCHANNEL_MARLIN_HIP_NT_CONTIGUOUS<
        T_hidden, char, WARP_NUM, BLOCK_SIZE_M, BLOCK_SIZE_N, BLOCK_SIZE_K,
        WARP_M, WARP_N, WARP_K, GROUP_N, GROUP_K, STAGES, N_LOOP_NUM,
        DIRECT_DWORDX4, LDS_SWIZZLE, VECTOR_A>), dim3(gridDim), dim3(blockDim), shared_mem_size, stream, 
        params.ptr_A,
        params.ptr_B0,
        params.ptr_C,
        params.ptr_A_scale,
        params.ptr_B_scale,
        params.m_indices,
        params.size_m,
        params.size_n,
        params.size_k,
        params.stride_asm,
        params.stride_bse,
        params.stride_bsn,
        params.stride_bsk,
        params.num_experts);
}
namespace megamoe_w4a8 {

constexpr int kW4A8HipcBlockM = 64;
template <typename scalar_t>
void launch_w4a8_hipc_contiguous_prefill(
    const torch::Tensor& input,
    const torch::Tensor& b_qweight,
    torch::Tensor& output,
    const torch::Tensor& a_scale,
    const torch::Tensor& b_scale,
    const torch::Tensor& m_indices,
    int mode) {
  const int size_m = input.size(0);
  const int size_k = input.size(1);
  const int size_n = output.size(1);
  const int stride_asm = a_scale.dim() == 1 ? 1 : a_scale.stride(0);
  const int stride_bsk = b_scale.dim() == 2 ? 1 : b_scale.stride(2);

  GemmParams_w4a8_contiguous<char, scalar_t> params(
      reinterpret_cast<const char*>(input.data_ptr<int8_t>()),
      reinterpret_cast<const char*>(b_qweight.data_ptr<int8_t>()),
      reinterpret_cast<scalar_t*>(output.data_ptr()),
      a_scale.data_ptr<float>(),
      b_scale.data_ptr<float>(),
      m_indices.data_ptr<int32_t>(),
      size_m,
      size_n,
      size_k,
      stride_asm,
      b_scale.stride(0),
      b_scale.stride(1),
      stride_bsk,
      b_qweight.size(0));

  if (mode == 1002) mode = 10644;
  #define W4A8_TILE_CASE(M, NL) \
    case 10000 + (M) * 10 + (NL): \
      launch_w4a8_hipc_contiguous_direct<M, 128, 64, ((M) < 64 ? (M) : 64), 32, 64, 2, char, scalar_t, NL, true>(params); \
      break
  switch (mode) {
    case 50641:
      launch_w4a8_hipc_contiguous_direct<64, 128, 64, 64, 32, 64, 2, char, scalar_t, 1, true, false, true>(params);
      break;
    case 50642:
      launch_w4a8_hipc_contiguous_direct<64, 128, 64, 64, 32, 64, 2, char, scalar_t, 2, true, false, true>(params);
      break;
    case 50644:
      launch_w4a8_hipc_contiguous_direct<64, 128, 64, 64, 32, 64, 2, char, scalar_t, 4, true, false, true>(params);
      break;
    case 51282:
      launch_w4a8_hipc_contiguous_direct<128, 128, 64, 128, 32, 64, 2, char, scalar_t, 2, true, false, true>(params);
      break;
    case 41281:
      launch_w4a8_hipc_contiguous_direct<128, 128, 64, 128, 32, 64, 2, char, scalar_t, 1, true>(params);
      break;
    case 41282:
      launch_w4a8_hipc_contiguous_direct<128, 128, 64, 128, 32, 64, 2, char, scalar_t, 2, true>(params);
      break;
    case 30644:
      launch_w4a8_hipc_contiguous_direct<64, 64, 64, 64, 32, 64, 2, char, scalar_t, 4, true>(params);
      break;
    case 31284:
      launch_w4a8_hipc_contiguous_direct<128, 64, 64, 64, 32, 64, 2, char, scalar_t, 4, true>(params);
      break;
    case 32564:
      launch_w4a8_hipc_contiguous_direct<256, 32, 64, 64, 32, 64, 2, char, scalar_t, 4, true>(params);
      break;
    case 20644:
      launch_w4a8_hipc_contiguous_direct<64, 128, 64, 64, 32, 64, 2, char, scalar_t, 4, true, true>(params);
      break;
    W4A8_TILE_CASE(32, 1);
    W4A8_TILE_CASE(32, 2);
    W4A8_TILE_CASE(32, 4);
    W4A8_TILE_CASE(64, 1);
    W4A8_TILE_CASE(64, 2);
    W4A8_TILE_CASE(64, 4);
    W4A8_TILE_CASE(128, 1);
    W4A8_TILE_CASE(128, 2);
    W4A8_TILE_CASE(128, 4);
    W4A8_TILE_CASE(256, 1);
    W4A8_TILE_CASE(256, 2);
    default: TORCH_CHECK(false, "unsupported W4A8 tile mode: ", mode);
  }
  #undef W4A8_TILE_CASE
}
torch::Tensor m_grouped_marlin_w4a8_gemm_nt_contiguous_hipc(
  torch::Tensor input,
  torch::Tensor b_qweight,
  torch::Tensor output,
  torch::Tensor a_scale,
  torch::Tensor b_scale,
  torch::Tensor m_indices,
  int mode) {

  const at::cuda::OptionalCUDAGuard device_guard(device_of(input));

  TORCH_CHECK(input.is_cuda() && b_qweight.is_cuda() && output.is_cuda() &&
                  a_scale.is_cuda() && b_scale.is_cuda() && m_indices.is_cuda(),
              "m_grouped_marlin_w4a8_gemm_nt_contiguous_hipc expects CUDA tensors");
  TORCH_CHECK(input.scalar_type() == at::ScalarType::Char, "input must be int8");
  TORCH_CHECK(b_qweight.scalar_type() == at::ScalarType::Char,
              "HIPC W4A8 path expects int8 shuffled packed weight");
  TORCH_CHECK(output.scalar_type() == at::ScalarType::BFloat16,
              "output must be bf16");
  TORCH_CHECK(a_scale.scalar_type() == at::ScalarType::Float, "a_scale must be float32");
  TORCH_CHECK(b_scale.scalar_type() == at::ScalarType::Float, "b_scale must be float32");
  TORCH_CHECK(m_indices.scalar_type() == at::ScalarType::Int, "m_indices must be int32");
  TORCH_CHECK(input.dim() == 2, "input must be [M, K]");
  TORCH_CHECK(output.dim() == 2, "output must be [M, N]");
  TORCH_CHECK(a_scale.dim() == 1 || (a_scale.dim() == 2 && a_scale.size(1) == 1),
              "a_scale must be [M] or [M, 1]");
  TORCH_CHECK(b_scale.dim() == 2 || (b_scale.dim() == 3 && b_scale.size(2) == 1),
              "b_scale must be [E, N] or [E, N, 1]");
  TORCH_CHECK(m_indices.dim() == 1, "m_indices must be [M]");
  TORCH_CHECK(input.size(0) == output.size(0) && input.size(0) == a_scale.size(0) &&
                  input.size(0) == m_indices.size(0),
              "M dimension mismatch");
  TORCH_CHECK(output.size(1) == b_scale.size(1), "N dimension mismatch");
  TORCH_CHECK(b_qweight.size(0) == b_scale.size(0), "expert dimension mismatch");
  TORCH_CHECK(input.size(1) > 0 && input.size(1) % 128 == 0, "K must be divisible by 128");
  TORCH_CHECK(output.size(1) > 0 && output.size(1) % 512 == 0, "N must be divisible by 512");
  for (const auto& tensor : {b_qweight, output, a_scale, b_scale, m_indices}) {
    TORCH_CHECK(tensor.device() == input.device(), "all tensors must use the same device");
  }
  TORCH_CHECK(
      b_qweight.numel() == b_qweight.size(0) * output.size(1) * input.size(1) / 2,
      "unexpected HIPC W4A8 b_qweight size");
  TORCH_CHECK(input.is_contiguous() && b_qweight.is_contiguous() && output.is_contiguous() &&
                  a_scale.is_contiguous() && b_scale.is_contiguous() && m_indices.is_contiguous(),
              "all tensors must be contiguous");

  if (input.size(0) == 0) return output;
  if (output.scalar_type() == at::ScalarType::BFloat16) {
    launch_w4a8_hipc_contiguous_prefill<bhalf_t>(
        input, b_qweight, output, a_scale, b_scale, m_indices, mode);
  }
  DG_HIP_CHECK(hipGetLastError());
  return output;
}

}
