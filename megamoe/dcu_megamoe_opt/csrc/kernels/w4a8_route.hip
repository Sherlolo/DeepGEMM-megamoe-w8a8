using namespace deep_gemm::mega;

struct RouteLayout {
    int ranks, experts, capacity, topk, hidden, rank;
    __device__ int64_t input_offset() const { return dcu_input_token_offset(ranks); }
    __device__ int64_t scale_offset() const { return input_offset() + int64_t(capacity) * hidden; }
    __device__ int64_t ids_offset() const { return scale_offset() + int64_t(capacity) * 4; }
    __device__ int64_t weights_offset() const { return ids_offset() + int64_t(capacity) * topk * 8; }
    __device__ int64_t combine_offset() const { return weights_offset() + int64_t(capacity) * topk * 4; }
};

template<bool Fill>
__global__ void routes_kernel(uint8_t* sym, RouteLayout p, int* counts,
                              const int* offsets, int* routes, int* indices,
                              int* inverse, float* route_weights) {
    const int task = blockIdx.x * blockDim.x + threadIdx.x;
    const int tasks_per_rank = p.capacity * p.topk;
    if (task >= p.ranks * tasks_per_rank) return;
    const int source = task / tasks_per_rank;
    const int slot = task % tasks_per_rank;
    auto* peer = dcu_peer_sym_buffer_ptrs(sym)[source];
    if (slot / p.topk >= *dcu_runtime_num_tokens_ptr(peer, p.ranks)) return;
    const int64_t expert = reinterpret_cast<const int64_t*>(peer + p.ids_offset())[slot];
    const int local_experts = p.experts / p.ranks;
    if (expert < p.rank * local_experts || expert >= (p.rank + 1) * local_experts) return;
    const int local = int(expert) - p.rank * local_experts;
    const int pos = atomicAdd(counts + local, 1);
    if constexpr (Fill) {
        const int row = offsets[local] + pos;
        routes[row] = task;
        indices[row] = local;
        if (inverse) {
            inverse[task] = row;
            route_weights[task] = reinterpret_cast<const float*>(peer + p.weights_offset())[slot];
        }
    }
}

__global__ void offsets_kernel(const int* counts, int* offsets, int experts, int alignment) {
    if (threadIdx.x == 0) {
        int sum = 0;
        for (int e = 0; e < experts; ++e) {
            offsets[e] = sum;
            sum += ((counts[e] + alignment - 1) / alignment) * alignment;
        }
        offsets[experts] = sum;
    }
}

__global__ void gather_kernel(uint8_t* sym, RouteLayout p, const int* routes,
                              int8_t* x, float* scales, int rows,
                              const int* active_rows) {
    const int end = active_rows ? *active_rows : rows;
    for (int row = blockIdx.x; row < end; row += gridDim.x) {
    const int task = routes[row];
    if (task < 0) {
        if (active_rows) continue;
        for (int c = threadIdx.x; c < p.hidden / 16; c += blockDim.x)
            reinterpret_cast<int4*>(x + int64_t(row) * p.hidden)[c] = make_int4(0, 0, 0, 0);
        if (threadIdx.x == 0) scales[row] = 1.f;
        continue;
    }
    const int source = task / (p.capacity * p.topk);
    const int token = (task % (p.capacity * p.topk)) / p.topk;
    auto* peer = dcu_peer_sym_buffer_ptrs(sym)[source];
    const auto* input = reinterpret_cast<const int4*>(peer + p.input_offset() + int64_t(token) * p.hidden);
    auto* output = reinterpret_cast<int4*>(x + int64_t(row) * p.hidden);
    for (int c = threadIdx.x; c < p.hidden / 16; c += blockDim.x) output[c] = input[c];
    if (threadIdx.x == 0) scales[row] = reinterpret_cast<const float*>(peer + p.scale_offset())[token];
    }
}

template<bool Vectorized>
__global__ void scatter_kernel(uint8_t* sym, RouteLayout p, const int* routes,
                               const hip_bfloat16* y, int rows) {
    const int row = blockIdx.x;
    if (row >= rows) return;
    const int task = routes[row];
    if (task < 0) return;
    const int source = task / (p.capacity * p.topk);
    const int slot = task % (p.capacity * p.topk);
    auto* peer = dcu_peer_sym_buffer_ptrs(sym)[source];
    const int64_t combine_row = int64_t(slot % p.topk) * p.capacity + slot / p.topk;
    auto* out = reinterpret_cast<hip_bfloat16*>(peer + p.combine_offset()) + combine_row * p.hidden;
    if constexpr (Vectorized) {
        union Pack { uint4 vector; uint16_t bits[8]; };
        const auto* input = reinterpret_cast<const uint4*>(y + int64_t(row) * p.hidden);
        auto* output = reinterpret_cast<uint4*>(out);
        for (int c = threadIdx.x; c < p.hidden / 8; c += blockDim.x) {
            output[c] = input[c];
        }
    } else {
        for (int c = threadIdx.x; c < p.hidden; c += blockDim.x)
            out[c] = y[int64_t(row) * p.hidden + c];
    }
}

__global__ void combine_kernel(uint8_t* sym, RouteLayout p, const int* group_map,
                               hip_bfloat16* y, int tokens) {
    asm volatile("buffer_wbinvl1_vol\n" ::: "memory");
    const int vector = blockIdx.x * blockDim.x + threadIdx.x;
    const int vectors_per_row = p.hidden / 8;
    if (vector >= tokens * vectors_per_row) return;
    const int token = vector / vectors_per_row;
    const int column = vector % vectors_per_row;
    const auto* ids = reinterpret_cast<const int64_t*>(sym + p.ids_offset()) + token * p.topk;
    const auto* weights = reinterpret_cast<const float*>(sym + p.weights_offset()) + token * p.topk;
    const auto* input = reinterpret_cast<const uint4*>(sym + p.combine_offset());
    float total[8] = {};
    // Match LightOp EP gather's FP32 FMA, BF16 rank partial, then DeepEP's
    // FP32 rank reduction. A canonical map preserves this rounding under EPLB.
    for (int owner = 0; owner < 8; ++owner) {
        float partial[8] = {};
        bool present = false;
        for (int slot = 0; slot < p.topk; ++slot) {
            const int64_t expert = ids[slot];
            if (expert < 0 || expert >= p.experts) continue;
            const int group = group_map ? group_map[expert] : int(expert) / (p.experts / p.ranks);
            if (group != owner) continue;
            present = true;
            union Pack { uint4 vector; uint16_t bits[8]; } value;
            value.vector = input[(int64_t(slot) * p.capacity + token) * vectors_per_row + column];
            const float weight = weights[slot];
            #pragma unroll
            for (int i = 0; i < 8; ++i)
                partial[i] = fmaf(bf16_bits_to_float(value.bits[i]), weight, partial[i]);
        }
        if (present) {
            #pragma unroll
            for (int i = 0; i < 8; ++i)
                total[i] += bf16_bits_to_float(float_to_bf16_bits(partial[i]));
        }
    }
    union Pack { uint4 vector; uint16_t bits[8]; } output;
    #pragma unroll
    for (int i = 0; i < 8; ++i) output.bits[i] = float_to_bf16_bits(total[i]);
    reinterpret_cast<uint4*>(y)[vector] = output.vector;
}

template<bool RankPartials = false>
__global__ void combine_topk6_kernel(uint8_t* sym, RouteLayout p, const int* group_map,
                                     hip_bfloat16* y) {
    asm volatile("buffer_wbinvl1_vol\n" ::: "memory");
    const int token = blockIdx.y;
    const int column = blockIdx.x * blockDim.x + threadIdx.x;
    const int vectors_per_row = p.hidden / 8;
    if (column >= vectors_per_row) return;
    const auto* ids = reinterpret_cast<const int64_t*>(sym + p.ids_offset()) + token * 6;
    const auto* weights = reinterpret_cast<const float*>(sym + p.weights_offset()) + token * 6;
    const auto* input = reinterpret_cast<const uint4*>(sym + p.combine_offset());
    uint64_t owner_slots = 0;
    #pragma unroll
    for (int slot = 0; slot < 6; ++slot) {
        const int64_t expert = ids[slot];
        if (expert < 0 || expert >= p.experts) continue;
        const int owner = group_map ? group_map[expert] : int(expert) / (p.experts / 8);
        if (owner >= 0 && owner < 8) owner_slots |= uint64_t(1) << (owner * 8 + slot);
    }
    float total[8] = {};
    for (int owner = 0; owner < 8; ++owner) {
        unsigned slots = unsigned(owner_slots >> (owner * 8)) & 0xffu;
        if (!slots) continue;
        if constexpr (RankPartials) {
            union Pack { uint4 vector; uint16_t bits[8]; } value;
            value.vector = input[(int64_t(owner) * p.capacity + token) * vectors_per_row + column];
            #pragma unroll
            for (int i = 0; i < 8; ++i) total[i] += bf16_bits_to_float(value.bits[i]);
            continue;
        }
        float partial[8] = {};
        do {
            const int slot = __builtin_ctz(slots);
            slots &= slots - 1;
            union Pack { uint4 vector; uint16_t bits[8]; } value;
            value.vector = input[(int64_t(slot) * p.capacity + token) * vectors_per_row + column];
            const float weight = weights[slot];
            #pragma unroll
            for (int i = 0; i < 8; ++i)
                partial[i] = fmaf(bf16_bits_to_float(value.bits[i]), weight, partial[i]);
        } while (slots);
        #pragma unroll
        for (int i = 0; i < 8; ++i)
            total[i] += bf16_bits_to_float(float_to_bf16_bits(partial[i]));
    }
    union Pack { uint4 vector; uint16_t bits[8]; } output;
    #pragma unroll
    for (int i = 0; i < 8; ++i) output.bits[i] = float_to_bf16_bits(total[i]);
    reinterpret_cast<uint4*>(y)[int64_t(token) * vectors_per_row + column] = output.vector;
}

__global__ void scatter_rank_partials_kernel(uint8_t* sym, RouteLayout p,
                                             const int* inverse, const float* route_weights,
                                             const uint4* down) {
    asm volatile("buffer_wbinvl1_vol\n" ::: "memory");
    // Spread peer writes across destinations instead of source-major bursts.
    const int source = (blockIdx.x + p.rank) & 7;
    const int token = blockIdx.x >> 3;
    auto* peer = dcu_peer_sym_buffer_ptrs(sym)[source];
    const int task_base = (source * p.capacity + token) * 6;
    unsigned slot_mask = 0;
    #pragma unroll
    for (int slot = 0; slot < 6; ++slot) {
        if (inverse[task_base + slot] >= 0) slot_mask |= 1u << slot;
    }
    if (!slot_mask) return;
    const int vectors_per_row = p.hidden / 8;
    auto* output = reinterpret_cast<uint4*>(peer + p.combine_offset()) +
        (int64_t(p.rank) * p.capacity + token) * vectors_per_row;
    for (int column = threadIdx.x; column < vectors_per_row; column += blockDim.x) {
        float partial[8] = {};
        unsigned slots = slot_mask;
        do {
            const int slot = __builtin_ctz(slots);
            slots &= slots - 1;
            const int row = inverse[task_base + slot];
            union Pack { uint4 vector; uint16_t bits[8]; } value;
            value.vector = down[int64_t(row) * vectors_per_row + column];
            const float weight = route_weights[task_base + slot];
            #pragma unroll
            for (int i = 0; i < 8; ++i)
                partial[i] = fmaf(bf16_bits_to_float(value.bits[i]), weight, partial[i]);
        } while (slots);
        union Pack { uint4 vector; uint16_t bits[8]; } result;
        #pragma unroll
        for (int i = 0; i < 8; ++i) result.bits[i] = float_to_bf16_bits(partial[i]);
        output[column] = result.vector;
    }
}

RouteLayout layout(const torch::Tensor& sym, int ranks, int experts, int capacity,
                   int topk, int hidden, int rank) {
    TORCH_CHECK(sym.is_cuda() && sym.is_contiguous() && sym.element_size() == 1,
                "sym must be a contiguous device byte buffer");
    TORCH_CHECK(ranks == 8 && experts > 0 && experts % ranks == 0 &&
                experts / ranks <= 64 && capacity > 0 && capacity % 4 == 0 && topk > 0 && topk <= experts &&
                hidden > 0 && hidden % 512 == 0 && rank >= 0 && rank < ranks,
                "W4A8 requires EP8, <=64 local experts, hidden multiple of 512, capacity multiple of 4, valid topk/rank");
    const int64_t bytes = combine_token_offset(ranks, experts, capacity, topk, hidden)
        + int64_t(capacity) * topk * hidden * 2;
    TORCH_CHECK(sym.numel() >= bytes, "symmetric buffer is too small");
    TORCH_CHECK(int64_t(ranks) * capacity * topk < INT32_MAX, "route index overflow");
    return {ranks, experts, capacity, topk, hidden, rank};
}

void check_tensor(const torch::Tensor& t, const torch::Tensor& sym,
                  at::ScalarType dtype, const char* name) {
    TORCH_CHECK(t.device() == sym.device() && t.scalar_type() == dtype && t.is_contiguous(),
                name, " has invalid device, dtype or layout");
}

torch::Tensor count_routes(torch::Tensor sym, int ranks, int experts, int capacity,
                            int topk, int hidden, int rank, int alignment) {
    const c10::cuda::CUDAGuard guard(sym.device());
    const auto p = layout(sym, ranks, experts, capacity, topk, hidden, rank);
    TORCH_CHECK(alignment == 64 || alignment == 128 || alignment == 256, "invalid route alignment");
    auto counts = torch::zeros({experts / ranks}, sym.options().dtype(torch::kInt32));
    auto offsets = torch::empty({experts / ranks + 1}, counts.options());
    const auto stream = at::cuda::getCurrentHIPStream();
   hipLaunchKernelGGL(( routes_kernel<false>), dim3((ranks * capacity * topk + 255) / 256), dim3(256), 0, stream, 
        (uint8_t*)sym.data_ptr(), p, counts.data_ptr<int>(), nullptr, nullptr, nullptr, nullptr, nullptr);
   hipLaunchKernelGGL(( offsets_kernel), dim3(1), dim3(64), 0, stream, counts.data_ptr<int>(), offsets.data_ptr<int>(), experts / ranks, alignment);
    TORCH_CHECK(hipGetLastError() == hipSuccess, "W4A8 route count launch failed");
    return offsets;
}

void gather_routes(torch::Tensor sym, torch::Tensor offsets, torch::Tensor routes,
                   torch::Tensor indices, torch::Tensor x, torch::Tensor scales,
                   int ranks, int experts, int capacity, int topk, int hidden, int rank,
                   bool device_rows, const std::optional<torch::Tensor>& inverse,
                   const std::optional<torch::Tensor>& route_weights) {
    const c10::cuda::CUDAGuard guard(sym.device());
    const auto p = layout(sym, ranks, experts, capacity, topk, hidden, rank);
    for (auto t : {offsets, routes, indices}) check_tensor(t, sym, at::kInt, "route metadata");
    check_tensor(x, sym, at::kChar, "x");
    check_tensor(scales, sym, at::kFloat, "scales");
    const int rows = routes.numel();
    int* inverse_ptr = nullptr;
    float* route_weights_ptr = nullptr;
    TORCH_CHECK(inverse.has_value() == route_weights.has_value(), "inverse and route_weights must be supplied together");
    if (inverse.has_value()) {
        check_tensor(*inverse, sym, at::kInt, "inverse");
        check_tensor(*route_weights, sym, at::kFloat, "route_weights");
        TORCH_CHECK(inverse->numel() == int64_t(ranks) * capacity * topk, "inverse shape mismatch");
        TORCH_CHECK(route_weights->numel() == inverse->numel(), "route_weights shape mismatch");
        inverse->fill_(-1);
        inverse_ptr = inverse->data_ptr<int>();
        route_weights_ptr = route_weights->data_ptr<float>();
    }
    TORCH_CHECK(offsets.numel() == experts / ranks + 1 && indices.numel() == rows &&
                x.dim() == 2 && x.size(0) == rows && x.size(1) == hidden && scales.numel() == rows,
                "route gather shape mismatch");
    auto counts = torch::zeros({experts / ranks}, offsets.options());
    routes.fill_(-1);
    indices.fill_(-1);
    const auto stream = at::cuda::getCurrentHIPStream();
   hipLaunchKernelGGL(( routes_kernel<true>), dim3((ranks * capacity * topk + 255) / 256), dim3(256), 0, stream, 
        (uint8_t*)sym.data_ptr(), p, counts.data_ptr<int>(), offsets.data_ptr<int>(),
        routes.data_ptr<int>(), indices.data_ptr<int>(), inverse_ptr, route_weights_ptr);
    if (rows)hipLaunchKernelGGL(( gather_kernel), dim3(::min(rows, 4096)), dim3(256), 0, stream, (uint8_t*)sym.data_ptr(), p,
        routes.data_ptr<int>(), x.data_ptr<int8_t>(), scales.data_ptr<float>(), rows,
        device_rows ? offsets.data_ptr<int>() + experts / ranks : nullptr);
    TORCH_CHECK(hipGetLastError() == hipSuccess, "W4A8 route gather launch failed");
}

void scatter_routes(torch::Tensor sym, torch::Tensor routes, torch::Tensor y,
                    int ranks, int experts, int capacity, int topk, int hidden, int rank,
                    bool vectorized) {
    const c10::cuda::CUDAGuard guard(sym.device());
    const auto p = layout(sym, ranks, experts, capacity, topk, hidden, rank);
    check_tensor(routes, sym, at::kInt, "routes");
    check_tensor(y, sym, at::kBFloat16, "y");
    TORCH_CHECK(y.dim() == 2 && y.size(0) == routes.numel() && y.size(1) == hidden,
                "route scatter shape mismatch");
    if (routes.numel()) {
        if (vectorized) {
           hipLaunchKernelGGL(( scatter_kernel<true>), dim3(routes.numel()), dim3(256), 0, at::cuda::getCurrentHIPStream(), 
                (uint8_t*)sym.data_ptr(), p, routes.data_ptr<int>(), (hip_bfloat16*)y.data_ptr(), routes.numel());
        } else {
           hipLaunchKernelGGL(( scatter_kernel<false>), dim3(routes.numel()), dim3(256), 0, at::cuda::getCurrentHIPStream(), 
                (uint8_t*)sym.data_ptr(), p, routes.data_ptr<int>(), (hip_bfloat16*)y.data_ptr(), routes.numel());
        }
    }
    TORCH_CHECK(hipGetLastError() == hipSuccess, "W4A8 route scatter launch failed");
}

void combine_routes(torch::Tensor sym, const std::optional<torch::Tensor>& group_map,
                    torch::Tensor y, int ranks, int experts, int capacity,
                    int topk, int hidden, int rank, bool compact, bool rank_partials) {
    const c10::cuda::CUDAGuard guard(sym.device());
    const auto p = layout(sym, ranks, experts, capacity, topk, hidden, rank);
    check_tensor(y, sym, at::kBFloat16, "y");
    TORCH_CHECK(y.dim() == 2 && y.size(0) <= capacity && y.size(1) == hidden, "combine output shape mismatch");
    const int* groups = nullptr;
    if (group_map.has_value()) {
        check_tensor(*group_map, sym, at::kInt, "group_map");
        TORCH_CHECK(group_map->dim() == 1 && group_map->numel() == experts, "group_map must have one entry per physical expert");
        groups = group_map->data_ptr<int>();
    }
    const int vectors = y.size(0) * hidden / 8;
    if (rank_partials) {
        TORCH_CHECK(topk == 6 && !group_map.has_value(), "rank partials require topk6 and canonical physical groups");
        TORCH_CHECK(sym.numel() >= combine_token_offset(ranks, experts, capacity, topk, hidden) +
                    int64_t(ranks) * capacity * hidden * 2, "rank partial buffer is too small");
    }
    if (vectors) {
        if (rank_partials) {
            const dim3 grid((hidden / 8 + 127) / 128, y.size(0));
           hipLaunchKernelGGL(( combine_topk6_kernel<true>), dim3(grid), dim3(128), 0, at::cuda::getCurrentHIPStream(), 
                (uint8_t*)sym.data_ptr(), p, nullptr, (hip_bfloat16*)y.data_ptr());
        } else if (compact && topk == 6) {
            const dim3 grid((hidden / 8 + 127) / 128, y.size(0));
           hipLaunchKernelGGL(( combine_topk6_kernel<false>), dim3(grid), dim3(128), 0, at::cuda::getCurrentHIPStream(), 
                (uint8_t*)sym.data_ptr(), p, groups, (hip_bfloat16*)y.data_ptr());
        } else {
           hipLaunchKernelGGL(( combine_kernel), dim3((vectors + 255) / 256), dim3(256), 0, at::cuda::getCurrentHIPStream(), 
                (uint8_t*)sym.data_ptr(), p, groups, (hip_bfloat16*)y.data_ptr(), y.size(0));
        }
    }
    TORCH_CHECK(hipGetLastError() == hipSuccess, "W4A8 combine launch failed");
}

void scatter_rank_partials(torch::Tensor sym, torch::Tensor inverse,
                           torch::Tensor route_weights, torch::Tensor down,
                           int ranks, int experts, int capacity, int topk, int hidden, int rank) {
    const c10::cuda::CUDAGuard guard(sym.device());
    const auto p = layout(sym, ranks, experts, capacity, topk, hidden, rank);
    check_tensor(inverse, sym, at::kInt, "inverse");
    check_tensor(route_weights, sym, at::kFloat, "route_weights");
    check_tensor(down, sym, at::kBFloat16, "down");
    TORCH_CHECK(topk == 6 && inverse.numel() == int64_t(ranks) * capacity * topk &&
                route_weights.numel() == inverse.numel() &&
                down.dim() == 2 && down.size(1) == hidden, "invalid rank-partial shape");
    TORCH_CHECK(sym.numel() >= combine_token_offset(ranks, experts, capacity, topk, hidden) +
                int64_t(ranks) * capacity * hidden * 2, "rank partial buffer is too small");
   hipLaunchKernelGGL(( scatter_rank_partials_kernel), dim3(ranks * capacity), dim3(256), 0, at::cuda::getCurrentHIPStream(), 
        (uint8_t*)sym.data_ptr(), p, inverse.data_ptr<int>(), route_weights.data_ptr<float>(),
        (const uint4*)down.data_ptr());
    TORCH_CHECK(hipGetLastError() == hipSuccess, "W4A8 rank-partial scatter launch failed");
}
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("gemm", &megamoe_w4a8::m_grouped_marlin_w4a8_gemm_nt_contiguous_hipc);
    m.def("count_routes", &count_routes);
    m.def("gather_routes", &gather_routes);
    m.def("scatter_routes", &scatter_routes);
    m.def("scatter_rank_partials", &scatter_rank_partials);
    m.def("combine_routes", &combine_routes);
}
